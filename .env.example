# Copiar a .env y completar con los IDs reales antes de la Fase 6.
# .env nunca se commitea (ver .gitignore). Estas variables quedan
# igual visibles en el JS que llega al navegador -- no son secretos
# de servidor, son IDs públicos de medición.

VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Endpoint del formulario "avísame" (Fase 4). Cualquier servicio que acepte
# un POST con JSON y responda 2xx sirve. Sin esta variable el formulario
# valida y avisa que es una maqueta, pero no manda nada.
VITE_FORM_ENDPOINT=
